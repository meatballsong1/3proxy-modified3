{
  "manifest_version": 3,
  "name": "ProxyHub VPN",
  "version": "1.1.0",
  "description": "Connect to your private VPN hub",
  "permissions": [
    "storage",
    "proxy",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16":  "icons/icon.png",
    "48":  "icons/icon.png",
    "128": "icons/icon.png"
  }
}