    console.log(`Tailscale tailnet: ${TS_TAILNET}`);
    console.log(`Tailscale API key: ${TS_API_KEY === 'tskey-api-kw8xy5TMZ611CNTRL-zu21D9HeRSchovFsCS1MRcN2nzgujDB2' ? 'NOT SET' : 'configured'}`);
});
